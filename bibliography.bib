  author = {Dehant, V{\'e}ronique and Laguerre, Raphael and Rekier, J{\'e}r{\'e}my and Rivoldini, Attilio and Triana, Santiago Andres and Trinh, Antony and Van Hoolst, Tim and Zhu, Ping},
