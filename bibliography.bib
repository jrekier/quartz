@article{Guo2019,
  title = {Formulation of a {{Triaxial Three-Layered Earth Rotation}}: {{Theory}} and {{Rotational Normal Mode Solutions}}},
  author = {Guo, Zhiliang and Shen, Wen Bin},
  year = {2020},
  journal = {Journal of Geophysical Research: Solid Earth},
  volume = {125},
