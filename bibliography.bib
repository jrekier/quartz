@article{PuicaEtAl2023,
  title = {Analytical Computation of Total Topographic Torque at the Core--Mantle Boundary and Its Impact on Tidally Driven Length-of-Day Variations},
  author = {Puica, M and Dehant, V and Folgueira, M and Van~Hoolst, T and Rekier, J},
