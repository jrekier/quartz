@article{HornschildEtAl2022,
  title = {On the Detectability of the Magnetic Fields Induced by Ocean Circulation in Geomagnetic Satellite Observations},
  author = {Hornschild, Aaron and Baerenzung, Julien and {Saynisch-Wagner}, Jan and Irrgang, Christopher and Thomas, Maik},
  year = {2022},
  month = dec,
  journal = {Earth, Planets and Space},
  volume = {74},
  number = {1},
