  doi = {10.1029/2020GL090568},
  urldate = {2023-01-03},
  abstract = {For the first time for any planetary body other than the Earth, the free wobble of the pole called the Chandler wobble has been detected for Mars with a period of 206.9 {\textpm} 0.5 days and amplitude of 10 cm from radio tracking observations of Mars Odyssey, Mars Reconnaissance Orbiter (MRO), and Mars Global Surveyor (MGS), in order of decreasing sensitivity. The motion of the rotation pole location on the surface of Mars, or polar motion, is observed using two different approaches: (1) joint global estimates of Mars' orientation and its gravity field and (2) time series solutions of C21 and S21. For Mars interior models, the Chandler wobble period is combined with other measurements including the moments of inertia from our estimated precession rate and tidal Love number k2 = 0.169 {\textpm} 0.006. The Chandler wobble period constrains the rheology of the Martian mantle and in particular its long-term frequency dependence.},
  langid = {english},
  keywords = {Chandler,mantle,Mars,wobble},
  file = {/Users/rekierj/Zotero/storage/BDUXWKFX/Konopliv et al - 2020 - Detection of the Chandler Wobble of Mars From Orbiting Spacecraft.pdf;/Users/rekierj/Zotero/storage/7G8MBP3S/2020GL090568.html}
}

@article{AndersonEtAl2011,
  title = {The {{Global Magnetic Field}} of {{Mercury}} from {{MESSENGER Orbital Observations}}},
  author = {Anderson, Brian J. and Johnson, Catherine L. and Korth, Haje and Purucker, Michael E. and Winslow, Reka M. and Slavin, James A. and Solomon, Sean C. and McNutt, Ralph L. and Raines, Jim M. and Zurbuchen, Thomas H.},
  year = {2011},
  month = sep,
  journal = {Science},
  volume = {333},
  number = {6051},
  pages = {1859--1862},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.1211001},
  urldate = {2023-01-03},
  abstract = {Magnetometer data acquired by the MESSENGER spacecraft in orbit about Mercury permit the separation of internal and external magnetic field contributions. The global planetary field is represented as a southward-directed, spin-aligned, offset dipole centered on the spin axis. Positions where the cylindrical radial magnetic field component vanishes were used to map the magnetic equator and reveal an offset of 484 {\textpm} 11 kilometers northward of the geographic equator. The magnetic axis is tilted by less than 3{$^\circ$} from the rotation axis. A magnetopause and tail-current model was defined by using 332 magnetopause crossing locations. Residuals of the net external and offset-dipole fields from observations north of 30{$^\circ$}N yield a best-fit planetary moment of 195 {\textpm} 10 nanotesla-RM3, where RM is Mercury's mean radius.}
}

@article{YokooEtAl2022,
