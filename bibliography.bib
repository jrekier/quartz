  urldate = {2023-12-05},
  abstract = {The differential axial rotation of the solid inner core (IC) is suggested by seismic observations and expected from core dynamics models. A rotation of the IC by an angle {$\alpha$} takes its degree 2, order 2 topography (peak-to-peak amplitude {$\delta$}h) out of its gravitational alignment with the mantle. This creates a gravity variation of degree 2, order 2 proportional to {$\delta$}h and to {$\alpha$}. Here, we use gravity observations from Satellite Laser Ranging, the Gravity Recovery and Climate Experiment (GRACE) and GRACE Follow-On to reconstruct the time-variable S2,2 Stokes coefficient. We show that for {$\delta$}h = 90 m, S2,2 provides upper bounds on {$\alpha$} of 0.09{$^\circ$}, 0.3{$^\circ$}, and 0.4{$^\circ$} at periods of {$\sim$}4, {$\sim$}6, and {$\sim$}12 years, respectively. These are overestimates, as our reconstructed S2,2 signal likely remains polluted by hydrology, although viscous relaxation of the IC can permit larger amplitudes.},
  copyright = {{\copyright} 2023 The Authors.},
  langid = {english},
  file = {/Users/rekierj/Zotero/storage/F96JPCZC/Lecomte et al. - 2023 - Gravitational Constraints on the Earth's Inner Core Differential Rotation.pdf;/Users/rekierj/Zotero/storage/2LIEU6ZR/2023GL104790.html}
