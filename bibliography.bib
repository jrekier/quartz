@article{ClesseEtAl2017,
  title = {Mimicking {{Dark Energy}} with the Backreactions of Gigaparsec Inhomogeneities},
  author = {Clesse, Sebastien and Roisin, Arnaud and F{\"u}zfa, Andr{\'e}},
  year = {2017},
  volume = {1},
  pages = {1--14},
  abstract = {Spatial averaging and time evolving are non-commutative operations in General Relativity, which questions the reliability of the FLRW model. The long standing issue of the importance of backreactions induced by cosmic inhomogeneities is addressed for a toy model assuming a peak in the primordial spectrum of density perturbations and a simple CDM cosmology. The backreactions of initial Hubble-size inhomogeneities are determined in a fully relativistic framework, from a series of simulations using the BSSN formalism of numerical relativity. In the FLRW picture, these backreactions can be effectively described by two so-called morphon scalar fields, one of them acting at late time like a tiny cosmological constant. Initial density contrasts ranging from \$10{\textasciicircum}\{-2\}\$ down to \$10{\textasciicircum}\{-4\}\$, on scales crossing the Hubble radius between \$z{\textbackslash}sim 45 \$ and \$z{\textbackslash}sim 1000\$ respectively, i.e. comoving gigaparsec scales, mimic a Dark Energy (DE) component that can reach \${\textbackslash}Omega\_\{{\textbackslash}mathrm\{DE\}\} {\textbackslash}approx 0.7\$ when extrapolated until today. A similar effect is not excluded for lower density contrasts but our results are then strongly contaminated by numerical noise and thus hardly reliable. A potentially detectable signature of this scenario is a phantom-like equation of state \$w{$<$} -1\$, at redshifts \$z{\textbackslash}gtrsim 4\$ for a density contrast of \$10{\textasciicircum}\{-2\}\$ initially, relaxing slowly to \$w {\textbackslash}approx -1\$ today. This new class of scenarios would send the fine-tuning and coincidence issues of Dark energy back to the mechanism at the origin of the primordial power spectrum enhancement, possibly in the context of inflation.},
  keywords = {Cosmology,General Relativity,Universe},
  file = {/Users/rekierj/Zotero/storage/DCVMYF9L/Clesse et al - 2017 - Mimicking Dark Energy with the backreactions of gigaparsec inhomogeneities.pdf}
}

@article{GuenelEtAl2016,
  title = {Tidal Dissipation by Inertial Waves in Differentially Rotating Convective Envelopes of Low-Mass Stars},
  author = {Guenel, Mathieu and Mathis, St{\'e}phane and Baruteau, Cl{\'e}ment and Rieutord, Michel},
  year = {2016},
  volume = {22},
  pages = {1--17},
  issn = {0004-6361},
  doi = {10.1051/0004-6361/201527621},
  abstract = {Tidal interactions in close star-planet or binary star systems may excite inertial waves (their restoring force is the Coriolis force) in the convective region of the stars. The dissipation of these waves plays a prominent role in the long-term orbital and rotational evolution of the bodies involved. If the primary star rotates as a solid body, inertial waves have a Doppler-shifted frequency restricted to the range \$[-2{\textbackslash}Omega, 2{\textbackslash}Omega]\$ (\${\textbackslash}Omega\$ being the angular velocity of the star), and they can propagate in the entire convective region. However, turbulent convection can sustain differential rotation with an equatorial acceleration (as in the Sun) or deceleration that modifies the frequency range and propagation domain of inertial waves and allows corotation resonances for non-axisymmetric oscillations. In this work, we perform numerical simulations of tidally excited inertial waves in a differentially rotating convective envelope with a conical (or latitudinal) rotation profile. The tidal forcing that we adopt contains spherical harmonics that correspond to the case of a circular and coplanar orbit. We study the viscous dissipation of the waves as a function of tidal frequency for various stellar masses and differential rotation parameters, as well as its dependence on the turbulent viscosity coefficient. We compare our results with previous studies assuming solid-body rotation and point out the potential key role of corotation resonances in the dynamical evolution of close-in star-planet or binary systems.},
  keywords = {hydrodynamics,planet-star interactions,rotation,stars,waves},
  file = {/Users/rekierj/Zotero/storage/9CJ3XJKG/Guenel et al - 2016 - Tidal dissipation by inertial waves in differentially rotating convective.pdf}
}

