@article{Cadek2016,
  title = {Enceladus's Internal Ocean and Ice Shell Constrained from {{Cassini}} Gravity, Shape, and Libration Data},
  author = {{\v C}adek, Ond{\v r}ej and Tobie, Gabriel and Van Hoolst, Tim and Mass{\'e}, Marion and Choblet, Ga{\"e}l and Lef{\`e}vre, Axel and Mitri, Giuseppe and Baland, Rose Marie and B{\v e}hounkov{\'a}, Marie and Bourgeois, Olivier and Trinh, Anthony},
