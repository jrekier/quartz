@article{RabittiMaas2014,
  title = {Inertial Wave Rays in Rotating Spherical Fluid Domains},
  author = {Rabitti, Anna and Maas, Leo R.M.},
  year = {2014},
  journal = {Journal of Fluid Mechanics},
  volume = {758},
