}

@article{Seo2021,
  title = {Secular Polar Motion Observed by {{GRACE}}},
  author = {Seo, Ki-Weon and Kim, Jae-Seung and Youm, Kookhyoun and Chen, Jianli and Wilson, Clark R.},
  year = {2021},
