@misc{RekierEtAl2023,
  title = {Electric Interface Condition for Sliding and Viscous Contacts},
  author = {Rekier, J{\'e}r{\'e}my and Triana, Santiago A. and Trinh, Antony and Buffett, Bruce A.},
  year = {2023},
  month = mar,
  number = {arXiv:2303.00718},
  eprint = {2303.00718},
  primaryclass = {astro-ph, physics:physics},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2303.00718},
  urldate = {2023-04-07},
  abstract = {First principles of electromagnetism impose that the tangential electric field must be continuous at the interface between two media. The definition of the electric field depends on the frame of reference leading to an ambiguity in the mathematical expression of the continuity condition when the two sides of the interface do not share the same rest frame. We briefly review the arguments supporting each choice of interface condition and illustrate how the most theoretically consistant choice leads to a paradox in induction experiments. We then present a model of sliding contact between two solids and between a fluid and a solid, and show how this paradox can be lifted by taking into account the shear induced by the differential motion in a thin intermediate viscous layer at the interface, thereby also lifting the ambiguity in the electric interface condition. We present some guidelines regarding the appropriate interface condition to employ in numerical simulations where sliding contact is used as an approximation to the viscous interface between a conducting solid and a fluid of very low viscosity such as in planetary interior simulations.},
  archiveprefix = {arXiv},
  copyright = {All rights reserved},
  keywords = {Astrophysics - Earth and Planetary Astrophysics,Physics - Classical Physics,Physics - Fluid Dynamics},
  file = {/Users/rekierj/Zotero/storage/5WKPJ8N9/Rekier et al - 2023 - Electric interface condition for sliding and viscous contacts.pdf;/Users/rekierj/Zotero/storage/8I5NF62T/2303.html}
}

