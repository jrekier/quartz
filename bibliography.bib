@article{Ivers2015,
  title = {Enumeration, Orthogonality and Completeness of the Incompressible {{Coriolis}} Modes in a Sphere},
  author = {Ivers, D. J. and Jackson, A. and Winch, D.},
  year = {2015},
  month = mar,
  journal = {Journal of Fluid Mechanics},
