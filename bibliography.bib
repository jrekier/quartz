@article{MooreSchubert2000,
  title = {The {{Tidal Response}} of {{Europa}}},
  author = {Moore, William B. and Schubert, Gerald},
  year = {2000},
  month = sep,
  journal = {Icarus},
  volume = {147},
  number = {1},
  pages = {317--319},
  issn = {0019-1035},
  doi = {10.1006/icar.2000.6460},
  urldate = {2023-09-08},
  abstract = {The tidal response of Europa to a time-varying potential is determined by solving the quasi-static equilibrium equations for a body composed of several uniform, Maxwell viscoelastic layers. Models in which Europa's surface ice extends all the way to the silicate mantle have weak tidal responses ({$\sim$}1 m vertical deflection) while models in which a liquid ``ocean'' underlies the ice have about 30 m peak vertical deflection. The phase-lag of the tidal response is very small ({$<$}2{$^\circ$}) in the case of an ocean, but may be large if there is no ocean and the ice has a viscosity around 1013 Pa s. For models with an ocean, the product of the thickness and strength of the ice determines the tidal response, making it difficult to determine the thickness of the ice by observing the tidal deflection of Europa.},
  keywords = {ObsCite},
  file = {/Users/rekierj/Zotero/storage/YTW8A2WI/Moore, Schubert - 2000 - The Tidal Response of Europa2.pdf;/Users/rekierj/Zotero/storage/3JENZVHQ/S0019103500964601.html}
}

@article{MooreSchubert2003,
  title = {The Tidal Response of {{Ganymede}} and {{Callisto}} with and without Liquid Water Oceans},
  author = {Moore, William B. and Schubert, Gerald},
  year = {2003},
  month = nov,
  journal = {Icarus},
  volume = {166},
  number = {1},
  pages = {223--226},
  issn = {0019-1035},
  doi = {10.1016/j.icarus.2003.07.001},
  urldate = {2023-09-08},
  abstract = {Calculations of the tidal responses of Ganymede and Callisto reveal that tidal amplitudes on these bodies may be as large as a few meters if a liquid ocean exists to decouple the surface ice from the interior. Tides on Ganymede's surface can exceed 7~m peak-to-peak variation, while on Callisto the tidal amplitude can exceed 5~m in the presence of a liquid ocean. Without an ocean, tidal amplitudes are less than 0.5~m on Ganymede and less than 0.3~m on Callisto. An orbiting spacecraft using an altimeter for crossover analysis and Doppler tracking from Earth should be able to achieve sufficient accuracy to identify the tidal amplitude to within about a meter over the course of a few months (observing tens of tidal cycles).},
  keywords = {ObsCite},
  file = {/Users/rekierj/Zotero/storage/LUMSXUCF/Moore, Schubert - 2003 - The tidal response of Ganymede and Callisto with and without liquid water oceans2.pdf;/Users/rekierj/Zotero/storage/ZQKR5379/S001910350300215X.html}
