  publisher = {Elsevier B.V.},
  issn = {00280836},
  doi = {10.1016/B978-0-444-53802-4.00168-8},
  abstract = {The rotation of the terrestrial planets of the solar system varies on short timescale and also evolves on a much longer timescale. Starting with the conservation equation for spin angular momentum of a planet, we introduce precession, nutation, and polar motion, which are manifestations of orientation changes and rotation rate variations. Next, techniques for rotation studies are reviewed. Excitation sources, both internal and external to the planet, are described and the influence of the interior structure on the rotation variations is quantified. For the study of the long-term spin evolution, a physical review of planetary dissipation mechanisms affecting rotation is given. Finally, the rotation results for Mars, Venus, and Mercury are summarized. For each planet, the mean rotation state is quantified and brief accounts are given of their rotation histories. Recent theoretical and observational results on periodic rotation variations of Mars, Venus, and Mercury are presented with an emphasis on their constraints on global properties of the planets.},
  isbn = {978-0-444-53803-1},
  keywords = {Atmosphere,earth,Internal structure,Libration,Mars,Mercury,nutation,Nutation,Obliquity,planets,Polar motion,precession,Precession,rotation,Rotation,Tides,Venus},
