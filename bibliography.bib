  issn = {0022-1120},
  doi = {10.1017/jfm.2015.27},
  abstract = {We consider incompressible flows in the rapid-rotation limit of small Rossby number and vanishing Ekman number, in a bounded volume with a rigid impenetrable rotating boundary. Physically the flows are inviscid, almost rigid rotations. We interpret the Coriolis force, modified by a pressure gradient, as a linear operator acting on smooth inviscid incompressible flows in the volume. The eigenfunctions of the Coriolis operator \${\textbackslash}boldsymbol\{\{{\textbackslash}mathcal\{C\}\}\}\$ so defined are the inertial modes (including any Rossby modes) and geostrophic modes of the rotating volume. We show \${\textbackslash}boldsymbol\{\{{\textbackslash}mathcal\{C\}\}\}\$ is a bounded operator and that \$-{\textbackslash}text\{i\}{\textbackslash}boldsymbol\{\{{\textbackslash}mathcal\{C\}\}\}\$ is symmetric, so that the Coriolis modes of different frequencies are orthogonal. We prove that the space of incompressible polynomial flows of degree \$N\$ or less in a sphere is invariant under \${\textbackslash}boldsymbol\{\{{\textbackslash}mathcal\{C\}\}\}\$ . The symmetry of \$-{\textbackslash}text\{i\}{\textbackslash}boldsymbol\{\{{\textbackslash}mathcal\{C\}\}\}\$ thus implies the Coriolis operator is non-defective on the finite-dimensional space of spherical polynomial flows. This enables us to enumerate the Coriolis modes, and to establish their completeness using the Weierstrass polynomial approximation theorem. The fundamental tool, which is required to establish invariance of spherical polynomial flows under \${\textbackslash}boldsymbol\{\{{\textbackslash}mathcal\{C\}\}\}\$ and completeness, is that the solution of the polynomial Poisson--Neumann problem, i.e. Poisson's equation with a Neumann boundary condition and polynomial data, in a sphere is a polynomial. We also enumerate the Coriolis modes in a sphere, with careful consideration of the geostrophic modes, directly from the known analytic solutions.},
  isbn = {0022-1120},
  keywords = {completeness,geostrophic modes,inertial modes,Inertial modes,inertial waves,tilted rotation,tri-axial ellipsoid},
  file = {/Users/rekierj/Zotero/storage/KD4XIC7M/Ivers et al - 2015 - Enumeration, orthogonality and completeness of the incompressible Coriolis.pdf}
}

