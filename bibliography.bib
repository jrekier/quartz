  shorttitle = {Resonant Tidal Responses in Rotating Fluid Bodies},
  author = {Lin, Yufeng and Ogilvie, Gordon I.},
  year = {2021},
  month = aug,
  journal = {arXiv:2108.08515 [astro-ph, physics:physics]},
  eprint = {2108.08515},
  primaryclass = {astro-ph, physics:physics},
  urldate = {2021-08-26},
  abstract = {In rotating stars and planets, excitation of inertial waves in convective envelopes provides an important channel for tidal dissipation, but the dissipation rate due to inertial waves depends erratically on the tidal frequency. Tidal dissipation is significantly enhanced at some frequencies, suggesting possible resonances between the tidal forcing and some eigenmodes. However, the nature of these resonances remains enigmatic owing to the singularity of the eigenvalue problem of inertial waves, and the resonances are often mistakenly attributed to wave attractors in the literature. In this letter, we reveal that resonant tidal responses correspond to inertial modes with large-scale flows hidden beneath localized wave beams. Strong couplings between the tidal forcing and the hidden large-scale flows intensify the localized wave beams emanating from the critical latitudes, leading to enhanced tidal dissipation. This study resolves a long-standing puzzle regarding the frequency-dependence of tidal dissipation due to inertial waves in convective envelopes.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Astrophysics - Earth and Planetary Astrophysics,Astrophysics - Solar and Stellar Astrophysics,Physics - Fluid Dynamics},
  file = {/Users/rekierj/Zotero/storage/4U6FEP72/Lin and Ogilvie - 2021 - Resonant tidal responses in rotating fluid bodies.pdf}
}

@article{DuanHuang2020,
