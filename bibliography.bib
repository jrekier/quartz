  pages = {1--35},
  issn = {21699356},
  doi = {10.1029/2019JB018571},
  abstract = {In this study, we formulated a triaxial three-layered anelastic Earth rotation theory considering various core-mantle couplings, including the pressure and gravitational couplings acting on the elastic inner core by the outer core and mantle, and the viscoelectromagnetic couplings between the outer core and mantle and between the outer and inner cores. With this formulation, using the eigenvalue method, we solved four rotational normal modes, including the Chandler Wobble (CW), Free Core Nutation (FCN), Free Inner Core Nutation (FICN), and the Inner Core Wobble (ICW). The triaxiality of the actual Earth has notable effects on rotational normal modes, that is, 0.005, 0.0, (Formula presented.) 0.071, and 1.174~d (mean solar days), respectively, for the CW, FCN, FICN, and ICW. In the case that the triaxiality is bigger, for instance, if the Earth's equatorial dynamical ellipticity were (Formula presented.), which is 1 order of magnitude larger than the presently determined ellipticity ((Formula presented.)), the CW and ICW periods will be lengthened by 3.579 and 94.912~d, and the FICN period will be decreased by 0.591~d. Based on our present knowledge, the numerical solutions of the four normal modes under the new rotation frame suggest that the periods of CW, FCN, FICN, and ICW are, respectively, 432.2, 429.9, 934.0, and 2,718.7~d. Our theory for Earth can be extended to other planets in our solar system.},
  file = {/Users/rekierj/Zotero/storage/7JYZMR9M/Guo, Shen - 2020 - Formulation of a Triaxial Three-Layered Earth Rotation.pdf}
}

@article{VanHoolst2002,
