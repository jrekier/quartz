@article{GizonEtAl2021,
  title = {Solar Inertial Modes: {{Observations}}, Identification, and Diagnostic Promise},
  shorttitle = {Solar Inertial Modes},
  author = {Gizon, Laurent and Cameron, Robert H. and Bekki, Yuto and Birch, Aaron C. and Bogart, Richard S. and Brun, Allan Sacha and Damiani, Cilia and Fournier, Damien and Hyest, Laura and Jain, Kiran and Lekshmi, B. and Liang, Zhi-Chao and Proxauf, Bastian},
